{
  "name": "nestjs-kafka-demo",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.18",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.18",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/platform-express": "^10.4.18",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.2.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.19",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
