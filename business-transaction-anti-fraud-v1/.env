# Application Configuration
APP_NAME=business-transaction-anti-fraud
APP_BASE_PATH=/transaction-anti-fraud/v1
APP_PORT=8085
APP_MAXIMUM_TRANSACTION_AMOUNT=1000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKERS=kafka:29092

# Kafka Producer Configuration
KAFKA_PRODUCER_TOPIC=transaction-processing

# Kafka Consumer Configuration
KAFKA_CONSUMER_GROUP_ID=reactive-group-01
KAFKA_CONSUMER_FROM_BEGINNING=true
KAFKA_CONSUMER_AUTO_COMMIT=false
KAFKA_CONSUMER_TOPIC=transaction-anti-fraud-validation

# Environment
NODE_ENV=development