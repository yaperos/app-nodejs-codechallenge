{
  "name": "nestjs-typeorm-openapi",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "build": "npx nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "migration:run": "npx typeorm migration:run -d ormconfig.ts",
    "migration:revert": "npx typeorm migration:revert -d ormconfig.ts",
    "migration:show": "npx typeorm migration:show -d ormconfig.ts",
    "migration:generate": "npx typeorm migration:generate -d ormconfig.ts",
    "schema:drop": "npx typeorm schema:drop -d ormconfig.ts",
    "schema:sync": "npx typeorm schema:sync -d ormconfig.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.5",
    "@types/kafkajs": "^1.8.2",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
