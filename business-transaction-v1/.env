# Environment
NODE_ENV=development

# Application Configuration
TRX_TYPE_220=Transferencias ordinaria
TRX_TYPE_225=Pago a cta tarjeta
TRX_TYPE_320=ORDINARIAS - INMEDIATAS
TRX_TYPE_325=PAGO DE TARJETA DE CREDITO - INMEDIATAS

TRX_STATUS_PENDING=PENDING
TRX_STATUS_APPROVED=APPROVED
TRX_STATUS_REJECTED=REJECTED

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=transaction_db
DATABASE_SSL=false

# Server Configuration
SERVER_PORT=3000

# Logging
LOG_LEVEL=debug

# Security
JWT_SECRET=your-super-secret-jwt-key
CORS_ORIGIN=http://localhost:3000


# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKERS=kafka:29092

# Kafka Producer Configuration
KAFKA_PRODUCER_TOPIC=transaction-anti-fraud-validation

# Kafka Consumer Configuration
KAFKA_CONSUMER_GROUP_ID=reactive-group
KAFKA_CONSUMER_FROM_BEGINNING=true
KAFKA_CONSUMER_AUTO_COMMIT=false
KAFKA_CONSUMER_TOPIC=transaction-processing