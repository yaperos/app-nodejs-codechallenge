DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testdb4?schema=public"
BROKER=localhost:9092
CLIENT_ID=app-gateway
CONSUMER_GROUP_ID=kafka-microservices
KAFKAJS_NO_PARTITIONER_WARNING=1