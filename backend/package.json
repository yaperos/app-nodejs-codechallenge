{
  "name": "app-nodejs-codechallenge",
  "version": "1.0.0",
  "description": "Our code challenge will let you marvel us with your Jedi coding skills :smile:.",
  "main": "index.js",
    "scripts": {
    "test": "jest --config jest.config.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate --schema libs/db/prisma/schema.prisma",
    "prisma:migrate:run": "prisma migrate deploy --schema libs/db/prisma/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --schema libs/db/prisma/schema.prisma --force",
    "prisma:migrate:save": "prisma migrate dev --create-only --schema libs/db/prisma/schema.prisma",
    "infra:up": "docker compose -f ../docker-compose.yml up -d",
    "infra:down": "docker compose -f ../docker-compose.yml down -v",
    "start:tx": "nest start transactions-api",
    "start:fraud": "nest start anti-fraud",
    "start:command": "nest start transactions-command",
    "dev:tx": "nest start transactions-api --watch",
    "dev:fraud": "nest start anti-fraud --watch",
    "dev:command": "nest start transactions-command --watch",
    "dev:all": "npx --yes concurrently -n tx,fraud,command -c blue,magenta,gray \"nest start transactions-api --watch\" \"nest start anti-fraud --watch\" \"nest start transactions-command --watch\"",
    "dev": "npm run infra:up && npm run dev:all",
    "db:seed": "prisma db seed --schema libs/db/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "ts-node libs/db/prisma/seeds/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmdpc/app-nodejs-codechallenge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/juanmdpc/app-nodejs-codechallenge/issues"
  },
  "homepage": "https://github.com/juanmdpc/app-nodejs-codechallenge#readme",
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@faker-js/faker": "9.9.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.2.1",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "concurrently": "9.2.0",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.3.0",
    "jest": "30.0.5",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  },
  "dependencies": {
    "@apollo/server": "4.12.2",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/microservices": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "6.0.0",
    "@prisma/client": "6.13.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "graphql": "16.11.0",
    "kafkajs": "2.2.4",
    "prisma": "6.13.0",
    "uuid": "11.1.0"
  },
  "engines": {
    "node": "22.18.x",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.3"
}