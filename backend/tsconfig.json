{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@shared/cache": [
        "libs/cache/src"
      ],
      "@shared/cache/*": [
        "libs/cache/src/*"
      ],
      "@shared/cache/cache-redis": [
        "libs/cache/cache-redis/src"
      ],
      "@shared/cache/cache-redis/*": [
        "libs/cache/cache-redis/src/*"
      ],
      "@shared/common": [
        "libs/common/src"
      ],
      "@shared/config": [
        "libs/config/src"
      ],
      "@shared/config/*": [
        "libs/config/src/*"
      ],
      "@shared/contracts": [
        "libs/contracts/src"
      ],
      "@shared/contracts/*": [
        "libs/contracts/src/*"
      ],
      "@shared/db": [
        "libs/db/src"
      ],
      "@shared/db/*": [
        "libs/db/src/*"
      ],
      "@shared/logging": [
        "libs/logging/src"
      ],
      "@shared/logging/*": [
        "libs/logging/src/*"
      ],
      "@shared/messaging": [
        "libs/messaging/src"
      ],
      "@shared/messaging/*": [
        "libs/messaging/src/*"
      ],
      "@shared/messaging/messaging-kafka": [
        "libs/messaging/messaging-kafka/src"
      ],
      "@shared/messaging/messaging-kafka/*": [
        "libs/messaging/messaging-kafka/src/*"
      ]
    }
  }
}