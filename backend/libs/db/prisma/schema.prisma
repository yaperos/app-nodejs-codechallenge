generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionType {
  id   String @id @default(uuid()) @db.Uuid
  name String

  transactions Transaction[]

  @@map("transaction_types")
}

model Transaction {
  id                      String            @id @default(uuid())
  status                  TransactionStatus @default(PENDING)
  value                   Int               @db.Integer
  externalId              String            @unique @default(uuid()) @map("external_id") @db.Uuid
  accountExternalIdCredit String            @map("account_external_id_credit") @db.Uuid
  accountExternalIdDebit  String            @map("account_external_id_debit") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  typeId String          @map("type_id") @db.Uuid
  type   TransactionType @relation(fields: [typeId], references: [id])

  @@index([externalId])
  @@index([createdAt])
  @@index([createdAt, status])
  @@map("transactions")
}

model Outbox {
  id          String       @id @default(uuid())
  topic       String
  key         String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  availableAt DateTime     @default(now()) @map("available_at")

  @@index([status, availableAt], name: "idx_outbox_status_available")
  @@map("outbox")
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboxStatus {
  SENDING
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
