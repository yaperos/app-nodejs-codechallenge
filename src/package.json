{
  "name": "app-nodejs-codechallenge",
  "version": "1.0.0",
  "description": "Anti-fraud transaction challenge service",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch app/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "pnpm run test:unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:watch": "jest --watch",
    "lint": "echo 'lint step pending'"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "kafkajs": "^2.2.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.8.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "jest": "^30.2.0",
    "prisma": "^6.17.1",
    "supertest": "^7.1.4",
    "testcontainers": "^11.7.1",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
